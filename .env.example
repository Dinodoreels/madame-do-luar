# Madame do Luar - exemplo de variaveis por ambiente
# Nunca coloque chaves reais neste arquivo. Use o painel do provedor em producao.

# Ambiente
APP_ENV=local
ENVIRONMENT_NAME=local
ADMIN_DIRECT_ACCESS=false
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_CORS_ORIGINS=null,http://localhost:8000,http://127.0.0.1:8000
ADMIN_EMAILS=admin@madamedoluar.com.br
JWT_SECRET=troque-por-um-segredo-com-mais-de-32-caracteres
JWT_ISSUER=madame-do-luar
JWT_EXPIRES_SECONDS=86400
LOG_LEVEL=INFO

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
RESTORE_DATABASE_URL=

# Pagamentos - Mercado Pago
PIX_GATEWAY=mercado_pago
PIX_CURRENCY=BRL
ALLOW_MOCK_PAYMENTS=false
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=https://madamedoluar.com.br/api/webhook/mercado-pago
MERCADO_PAGO_LEITURA_AMOUNT=19.90
MERCADO_PAGO_LEITURA_CREDITS=100
MERCADO_PAGO_ASSINATURA_MENSAL_AMOUNT=49.90
MERCADO_PAGO_ASSINATURA_MENSAL_CREDITS=1500
MERCADO_PAGO_ASSINATURA_ANUAL_AMOUNT=397.00
MERCADO_PAGO_ASSINATURA_ANUAL_CREDITS=18250
MERCADO_PAGO_RECARGA_100_AMOUNT=19.90
MERCADO_PAGO_RECARGA_100_CREDITS=100
MERCADO_PAGO_RECARGA_300_AMOUNT=49.90
MERCADO_PAGO_RECARGA_300_CREDITS=300
MERCADO_PAGO_RECARGA_500_AMOUNT=79.90
MERCADO_PAGO_RECARGA_500_CREDITS=500
MERCADO_PAGO_RECARGA_1500_AMOUNT=199.90
MERCADO_PAGO_RECARGA_1500_CREDITS=1500

# Pagamentos legados/compatibilidade
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LEITURA=
STRIPE_PRICE_ASSINATURA_MENSAL=
STRIPE_PRICE_ASSINATURA_ANUAL=
STRIPE_PRICE_MENSAL_PIX=

# WhatsApp / Uazapi
WHATSAPP_PROVIDER=uazapi
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_TEST_NUMBER=
WHATSAPP_DEFAULT_RECIPIENT=
UAZAPI_CONVERT=true
WHATSAPP_INSTANCE_NAME=
WHATSAPP_SEND_DELAY_MS=800
WHATSAPP_LINK_PREVIEW=false
ALLOW_SIMULATED_NOTIFICATIONS=true

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DEFAULT_RECIPIENT=

# Workers e operacao
AUTOMATION_WORKER_INTERVAL_SECONDS=300
AUTOMATION_SYNC_RULES_ON_START=true
AUTOMATION_RETRY_DELAY_MINUTES=30
PENDING_MESSAGES_ALERT_THRESHOLD=20
BACKUP_DIR=backups
