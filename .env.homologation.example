# Madame do Luar - exemplo para homologacao/staging
# Usar Environment Group separado do local e da producao.

APP_ENV=staging
ENVIRONMENT_NAME=homologation
ADMIN_DIRECT_ACCESS=false
APP_BASE_URL=https://homolog.madamedoluar.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_CORS_ORIGINS=https://homolog.madamedoluar.com.br
ADMIN_EMAILS=admin-homolog@madamedoluar.com.br
JWT_SECRET=<secret-homolog-com-mais-de-32-caracteres>
JWT_ISSUER=madame-do-luar-homolog
JWT_EXPIRES_SECONDS=86400
LOG_LEVEL=INFO

GEMINI_API_KEY=<secret-homolog>
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

SUPABASE_URL=<supabase-homolog-url>
SUPABASE_KEY=<supabase-homolog-anon-or-service-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-homolog-service-role>
DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=<secret-homolog-opcional-para-backup-e-migration>
RESTORE_DATABASE_URL=

PIX_GATEWAY=mercado_pago
PIX_CURRENCY=BRL
ALLOW_MOCK_PAYMENTS=false
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_PUBLIC_KEY=<publica-sandbox>
MERCADO_PAGO_ACCESS_TOKEN=<secret-sandbox-homolog>
MERCADO_PAGO_WEBHOOK_SECRET=<secret-webhook-homolog>
MERCADO_PAGO_NOTIFICATION_URL=https://homolog.madamedoluar.com.br/api/webhook/mercado-pago
MERCADO_PAGO_LEITURA_AMOUNT=19.90
MERCADO_PAGO_LEITURA_CREDITS=100
MERCADO_PAGO_ASSINATURA_MENSAL_AMOUNT=49.90
MERCADO_PAGO_ASSINATURA_MENSAL_CREDITS=1500
MERCADO_PAGO_ASSINATURA_ANUAL_AMOUNT=397.00
MERCADO_PAGO_ASSINATURA_ANUAL_CREDITS=18250
MERCADO_PAGO_RECARGA_100_AMOUNT=19.90
MERCADO_PAGO_RECARGA_100_CREDITS=100
MERCADO_PAGO_RECARGA_300_AMOUNT=49.90
MERCADO_PAGO_RECARGA_300_CREDITS=300
MERCADO_PAGO_RECARGA_500_AMOUNT=79.90
MERCADO_PAGO_RECARGA_500_CREDITS=500
MERCADO_PAGO_RECARGA_1500_AMOUNT=199.90
MERCADO_PAGO_RECARGA_1500_CREDITS=1500

WHATSAPP_PROVIDER=uazapi
WHATSAPP_API_URL=<uazapi-homolog-url>
WHATSAPP_API_TOKEN=<secret-homolog>
WHATSAPP_TEST_NUMBER=<numero-controlado>
WHATSAPP_DEFAULT_RECIPIENT=
UAZAPI_CONVERT=true
WHATSAPP_INSTANCE_NAME=homolog
WHATSAPP_SEND_DELAY_MS=800
WHATSAPP_LINK_PREVIEW=false
ALLOW_SIMULATED_NOTIFICATIONS=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-homolog-user>
SMTP_PASS=<smtp-homolog-secret>

AUTOMATION_WORKER_INTERVAL_SECONDS=300
AUTOMATION_SYNC_RULES_ON_START=true
AUTOMATION_RETRY_DELAY_MINUTES=30
PENDING_MESSAGES_ALERT_THRESHOLD=20
BACKUP_DIR=backups
